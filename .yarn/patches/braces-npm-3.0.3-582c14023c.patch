diff --git a/lib/depth-guard.js b/lib/depth-guard.js
new file mode 100644
index 0000000000000000000000000000000000000000..0f0e445c6dd1126d9fa531d567bed49908b52878
--- /dev/null
+++ b/lib/depth-guard.js
@@ -0,0 +1,43 @@
+'use strict';
+
+// GHSA-vfj7-8cjw-p6xm: never recurse over attacker-controlled AST depth.
+const MAX_DEPTH = 128;
+const MAX_NODES = 262144;
+const reject = () => {
+  const error = new RangeError('Brace AST exceeds safe nesting or traversal limit');
+  error.code = 'BRACES_AST_LIMIT';
+  throw error;
+};
+
+const assertSafeAst = ast => {
+  const active = new WeakSet();
+  const ancestors = new WeakSet();
+  let ancestor = ast;
+  let ancestorDepth = 0;
+  while (ancestor && typeof ancestor === 'object') {
+    if (++ancestorDepth > MAX_DEPTH || ancestors.has(ancestor)) reject();
+    ancestors.add(ancestor);
+    ancestor = ancestor.parent;
+  }
+  if (ancestor !== undefined && ancestor !== null) reject();
+  const pending = [{ node: ast, depth: 0, parent: ast && ast.parent, leave: false }];
+  let count = 0;
+  while (pending.length) {
+    const { node, depth, parent, leave } = pending.pop();
+    if (!node || typeof node !== 'object') throw new TypeError('Expected an AST node');
+    if (leave) { active.delete(node); continue; }
+    if (depth > MAX_DEPTH || ++count > MAX_NODES || active.has(node)) reject();
+    if (node.parent !== undefined && node.parent !== parent) reject();
+    active.add(node);
+    pending.push({ node, depth, parent, leave: true });
+    if (node.nodes) {
+      if (!Array.isArray(node.nodes)) throw new TypeError('Expected AST nodes array');
+      if (node.nodes.length > MAX_NODES - count) reject();
+      for (let i = node.nodes.length - 1; i >= 0; i--) {
+        pending.push({ node: node.nodes[i], depth: depth + 1, parent: node, leave: false });
+      }
+    }
+  }
+};
+
+module.exports = { MAX_DEPTH, assertSafeAst, reject };
