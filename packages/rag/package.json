{
  "name": "@dzupagent/rag",
  "version": "0.2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./local-evaluation": {
      "import": "./dist/local-evaluation.js",
      "types": "./dist/local-evaluation.d.ts"
    }
  },
  "scripts": {
    "build": "node ../../scripts/run-with-build-custody.mjs --shell \"node ../../scripts/prepare-build-artifact-manifest.mjs && tsup && tsc -p tsconfig.build.json --emitDeclarationOnly --declarationMap false && node ../../scripts/write-build-artifact-manifest.mjs\"",
    "build:verify": "node ../../scripts/run-with-build-custody.mjs node ../../scripts/check-build-artifact-integrity.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS='--max-old-space-size=4096' vitest run",
    "test:integration": "NODE_OPTIONS='--max-old-space-size=4096' vitest run src/__tests__/qdrant-factory.test.ts",
    "test:watch": "vitest",
    "lint": "node ../../scripts/run-package-lint.mjs",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=4096' vitest run --coverage"
  },
  "dependencies": {
    "@dzupagent/core": "0.2.0",
    "@dzupagent/memory": "0.2.0",
    "@dzupagent/runtime-contracts": "0.2.0",
    "@dzupagent/security": "0.2.0"
  },
  "peerDependencies": {
    "@langchain/core": ">=1.0.0",
    "@qdrant/js-client-rest": ">=1.9.0",
    "zod": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@qdrant/js-client-rest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@langchain/core": "^1.1.39",
    "tsup": "*",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datazup/dzupagent.git",
    "directory": "packages/rag"
  }
}
