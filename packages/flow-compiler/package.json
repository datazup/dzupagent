{
  "name": "@dzupagent/flow-compiler",
  "version": "0.2.0",
  "type": "module",
  "description": "Flow compiler for DzupAgent — compiles flow-ast into skill-chain, workflow-builder, or pipeline artifacts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./agent-blueprints": {
      "import": "./dist/agent-blueprints.js",
      "types": "./dist/agent-blueprints.d.ts"
    },
    "./v2-inactive-local-target": {
      "import": "./dist/v2-inactive-local-target.js",
      "types": "./dist/v2-inactive-local-target.d.ts"
    },
    "./file-import-lock-chain-backend": {
      "import": "./dist/file-import-lock-chain-backend.js",
      "types": "./dist/file-import-lock-chain-backend.d.ts"
    }
  },
  "bin": {
    "dzupagent-compile": "dist/bin/compile.js",
    "dzupagent-qualify-flow-corpus": "dist/bin/qualify-corpus.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/run-with-build-custody.mjs --shell \"node ../../scripts/prepare-build-artifact-manifest.mjs && tsup && tsc -p tsconfig.build.json --emitDeclarationOnly --declarationMap false && node ../../scripts/write-build-artifact-manifest.mjs\"",
    "build:verify": "node ../../scripts/run-with-build-custody.mjs node ../../scripts/check-build-artifact-integrity.mjs",
    "lint": "node ../../scripts/run-package-lint.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@dzupagent/core": "0.2.0",
    "@dzupagent/flow-ast": "0.2.0"
  },
  "dependencies": {
    "@dzupagent/flow-dsl": "0.2.0",
    "@dzupagent/runtime-contracts": "0.2.0"
  },
  "devDependencies": {
    "@dzupagent/app-tools": "0.2.0",
    "@dzupagent/core": "0.2.0",
    "@dzupagent/flow-ast": "0.2.0",
    "tsup": "*",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datazup/dzupagent.git",
    "directory": "packages/flow-compiler"
  }
}
