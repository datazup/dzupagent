{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*.ts", "test/**/*.mjs", "test/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "coverage"]
}
