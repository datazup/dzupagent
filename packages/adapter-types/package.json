{
  "name": "@dzupagent/adapter-types",
  "version": "0.2.0",
  "type": "module",
  "description": "Type definitions for DzupAgent agent adapters — enables third-party adapter implementations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./provider-session": {
      "import": "./dist/provider-session.js",
      "types": "./dist/provider-session.d.ts"
    },
    "./provider-session-explorer": {
      "import": "./dist/provider-session-explorer.js",
      "types": "./dist/provider-session-explorer.d.ts"
    },
    "./monitoring/installation": {
      "import": "./dist/monitoring/installation.js",
      "types": "./dist/monitoring/installation.d.ts"
    },
    "./monitoring/health": {
      "import": "./dist/monitoring/health.js",
      "types": "./dist/monitoring/health.d.ts"
    },
    "./monitoring/lifecycle": {
      "import": "./dist/monitoring/lifecycle.js",
      "types": "./dist/monitoring/lifecycle.d.ts"
    },
    "./monitoring/posture": {
      "import": "./dist/monitoring/posture.js",
      "types": "./dist/monitoring/posture.d.ts"
    },
    "./monitoring/dashboard": {
      "import": "./dist/monitoring/dashboard.js",
      "types": "./dist/monitoring/dashboard.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/run-with-build-custody.mjs --shell \"node ../../scripts/prepare-build-artifact-manifest.mjs && tsup && tsc -p tsconfig.build.json --emitDeclarationOnly --declarationMap false && node ../../scripts/write-build-artifact-manifest.mjs\"",
    "build:verify": "node ../../scripts/run-with-build-custody.mjs node ../../scripts/check-build-artifact-integrity.mjs",
    "lint": "node ../../scripts/run-package-lint.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dzupagent/runtime-contracts": "0.2.0"
  },
  "devDependencies": {
    "eslint": "^10.1.0",
    "tsup": "*",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datazup/dzupagent.git",
    "directory": "packages/adapter-types"
  }
}
