{
  "name": "@dzupagent/flow-dsl",
  "version": "0.2.0",
  "type": "module",
  "description": "Textual dzupflow/v1 parser and bounded v2 compatibility frontend, formatter, validator, and graph projection for DzupAgent",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./source-map": {
      "import": "./dist/dsl-source-map.js",
      "types": "./dist/dsl-source-map.d.ts"
    },
    "./v2-policy-narrowing": {
      "import": "./dist/v2-policy-narrowing.js",
      "types": "./dist/v2-policy-narrowing.d.ts"
    },
    "./v2-retry-policy": {
      "import": "./dist/v2-retry-policy.js",
      "types": "./dist/v2-retry-policy.d.ts"
    },
    "./v2-terminal-catch": {
      "import": "./dist/v2-terminal-catch.js",
      "types": "./dist/v2-terminal-catch.d.ts"
    },
    "./v2-multi-port-save": {
      "import": "./dist/v2-multi-port-save.js",
      "types": "./dist/v2-multi-port-save.d.ts"
    },
    "./v2-authoring": {
      "import": "./dist/v2-authoring.js",
      "types": "./dist/v2-authoring.d.ts"
    },
    "./v2-import-lock-chain": {
      "import": "./dist/v2-import-lock-chain.js",
      "types": "./dist/v2-import-lock-chain.d.ts"
    },
    "./template-declaration": {
      "import": "./dist/template-declaration.js",
      "types": "./dist/template-declaration.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly --declarationMap false && node ../../scripts/write-build-artifact-manifest.mjs",
    "build:verify": "node ../../scripts/check-build-artifact-integrity.mjs",
    "lint": "node ../../scripts/run-package-lint.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dzupagent/flow-ast": "0.2.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@dzupagent/flow-ast": "0.2.0",
    "tsup": "*",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datazup/dzupagent.git",
    "directory": "packages/flow-dsl"
  }
}
