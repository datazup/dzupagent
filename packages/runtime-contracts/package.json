{
  "name": "@dzupagent/runtime-contracts",
  "version": "0.2.0",
  "type": "module",
  "description": "Neutral runtime contracts for scheduling and execution ledger packages",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./orchestration": {
      "import": "./dist/orchestration.js",
      "types": "./dist/orchestration.d.ts"
    },
    "./rag": {
      "import": "./dist/rag.js",
      "types": "./dist/rag.d.ts"
    },
    "./agent-review": {
      "import": "./dist/agent-review.js",
      "types": "./dist/agent-review.d.ts"
    },
    "./agent-blueprint": {
      "import": "./dist/agent-blueprint.js",
      "types": "./dist/agent-blueprint.d.ts"
    },
    "./fixtures/agent-review-conformance-v1.json": {
      "types": "./fixtures/agent-review-conformance-v1.d.ts",
      "default": "./fixtures/agent-review-conformance-v1.json"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly --declarationMap false && node ../../scripts/write-build-artifact-manifest.mjs",
    "build:verify": "node ../../scripts/check-build-artifact-integrity.mjs",
    "lint": "node ../../scripts/run-package-lint.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "*",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datazup/dzupagent.git",
    "directory": "packages/runtime-contracts"
  }
}
