{
  "name": "@dzupagent/runtime-contracts",
  "version": "0.2.0",
  "type": "module",
  "description": "Neutral runtime contracts for scheduling and execution ledger packages",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./ai-execution": {
      "import": "./dist/ai-execution.js",
      "types": "./dist/ai-execution.d.ts"
    },
    "./ai-execution/node": {
      "import": "./dist/ai-execution-node.js",
      "types": "./dist/ai-execution-node.d.ts"
    },
    "./ai-budget-reservation": {
      "import": "./dist/ai-budget-reservation.js",
      "types": "./dist/ai-budget-reservation.d.ts"
    },
    "./effect-receipt": {
      "import": "./dist/effect-receipt.js",
      "types": "./dist/effect-receipt.d.ts"
    },
    "./loop-economics-evidence": {
      "import": "./dist/loop-economics-evidence.js",
      "types": "./dist/loop-economics-evidence.d.ts"
    },
    "./loop-economics-evidence-v2": {
      "import": "./dist/loop-economics-evidence-v2.js",
      "types": "./dist/loop-economics-evidence-v2.d.ts"
    },
    "./execution-boundary-evidence": {
      "import": "./dist/execution-boundary-evidence.js",
      "types": "./dist/execution-boundary-evidence.d.ts"
    },
    "./canonical-execution": {
      "import": "./dist/canonical-execution.js",
      "types": "./dist/canonical-execution.d.ts"
    },
    "./orchestration": {
      "import": "./dist/orchestration.js",
      "types": "./dist/orchestration.d.ts"
    },
    "./rag": {
      "import": "./dist/rag.js",
      "types": "./dist/rag.d.ts"
    },
    "./agent-review": {
      "import": "./dist/agent-review.js",
      "types": "./dist/agent-review.d.ts"
    },
    "./agent-blueprint": {
      "import": "./dist/agent-blueprint.js",
      "types": "./dist/agent-blueprint.d.ts"
    },
    "./provider-session": {
      "import": "./dist/provider-session.js",
      "types": "./dist/provider-session.d.ts"
    },
    "./recursive-scope": {
      "import": "./dist/recursive-scope/index.js",
      "types": "./dist/recursive-scope/index.d.ts"
    },
    "./pipeline-artifact": {
      "import": "./dist/pipeline-artifact/index.js",
      "types": "./dist/pipeline-artifact/index.d.ts"
    },
    "./fixtures/agent-review-conformance-v1.json": {
      "types": "./fixtures/agent-review-conformance-v1.d.ts",
      "default": "./fixtures/agent-review-conformance-v1.json"
    },
    "./fixtures/ai-execution-conformance-v1.json": {
      "types": "./fixtures/ai-execution-conformance-v1.d.ts",
      "default": "./fixtures/ai-execution-conformance-v1.json"
    },
    "./fixtures/ai-execution-conformance-v2.json": {
      "types": "./fixtures/ai-execution-conformance-v2.d.ts",
      "default": "./fixtures/ai-execution-conformance-v2.json"
    },
    "./fixtures/provider-session-conformance-v2.json": {
      "types": "./fixtures/provider-session-conformance-v2.d.ts",
      "default": "./fixtures/provider-session-conformance-v2.json"
    },
    "./fixtures/provider-session-conformance-v1.json": {
      "types": "./fixtures/provider-session-conformance-v1.d.ts",
      "default": "./fixtures/provider-session-conformance-v1.json"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "node ../../scripts/run-with-build-custody.mjs --shell \"node ../../scripts/prepare-build-artifact-manifest.mjs && tsup && tsc -p tsconfig.build.json --emitDeclarationOnly --declarationMap false && node ../../scripts/write-build-artifact-manifest.mjs\"",
    "build:verify": "node ../../scripts/run-with-build-custody.mjs node ../../scripts/check-build-artifact-integrity.mjs",
    "lint": "node ../../scripts/run-package-lint.mjs",
    "test": "vitest run",
    "fixtures:ai-execution:check": "node scripts/check-ai-execution-conformance.mjs",
    "fixtures:provider-session:check": "node scripts/check-provider-session-conformance.mjs",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "tsup": "*",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datazup/dzupagent.git",
    "directory": "packages/runtime-contracts"
  }
}
