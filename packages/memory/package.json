{
  "name": "@dzupagent/memory",
  "version": "0.2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./knowledge": {
      "import": "./dist/knowledge/index.js",
      "types": "./dist/knowledge/index.d.ts"
    },
    "./lifecycle": {
      "import": "./dist/lifecycle/index.js",
      "types": "./dist/lifecycle/index.d.ts"
    },
    "./records": {
      "import": "./dist/records/index.js",
      "types": "./dist/records/index.d.ts"
    },
    "./projections": {
      "import": "./dist/projections/index.js",
      "types": "./dist/projections/index.d.ts"
    },
    "./retrieval": {
      "import": "./dist/retrieval/index.js",
      "types": "./dist/retrieval/index.d.ts"
    },
    "./service": {
      "import": "./dist/service/index.js",
      "types": "./dist/service/index.d.ts"
    },
    "./testing": {
      "import": "./dist/testing/index.js",
      "types": "./dist/testing/index.d.ts"
    },
    "./workers": {
      "import": "./dist/workers/index.js",
      "types": "./dist/workers/index.d.ts"
    }
  },
  "scripts": {
    "build": "node ../../scripts/run-with-build-custody.mjs --shell \"node ../../scripts/prepare-build-artifact-manifest.mjs && node scripts/clean-dist.mjs && tsc -p tsconfig.build.json --declarationMap false --pretty false && node ../../scripts/write-build-artifact-manifest.mjs\"",
    "build:verify": "node ../../scripts/run-with-build-custody.mjs node ../../scripts/check-build-artifact-integrity.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "node ../../scripts/run-package-lint.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dzupagent/agent-types": "0.2.0",
    "@dzupagent/cache": "0.2.0",
    "@dzupagent/memory-ipc": "0.2.0",
    "@dzupagent/security": "0.2.0",
    "proper-lockfile": "^4.1.2",
    "ulidx": "^2.4.1"
  },
  "peerDependencies": {
    "@langchain/core": ">=1.0.0",
    "@langchain/langgraph": ">=1.0.0",
    "ioredis": ">=5.0.0",
    "vitest": ">=1.0.0",
    "zod": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@langchain/core": "^1.1.39",
    "@langchain/langgraph": "^1.2.5",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.1",
    "@types/proper-lockfile": "^4.1.4",
    "ioredis": "^5.8.2",
    "tsup": "*",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "zod": "^4.3.6"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datazup/dzupagent.git",
    "directory": "packages/memory"
  }
}
