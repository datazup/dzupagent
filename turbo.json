{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["YARN_IGNORE_PATH", "YARN_CACHE_FOLDER", "YARN_GLOBAL_FOLDER", "npm_config_prefix"],
  "globalPassThroughEnv": ["DZUP_BUILD_CUSTODY_TOKEN"],
  "globalDependencies": [
    ".yarnrc.yml",
    "package.json",
    "turbo.json",
    "tsconfig.json",
    "yarn.lock",
    "scripts/build-artifact-integrity.mjs",
    "scripts/build-custody.mjs",
    "scripts/check-package-export-artifacts.mjs",
    "scripts/prepare-build-artifact-manifest.mjs",
    "scripts/run-with-build-custody.mjs",
    "scripts/write-build-artifact-manifest.mjs"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build:verify"],
      "outputs": ["dist/**"],
      "outputLogs": "new-only"
    },
    "build:verify": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [],
      "outputLogs": "new-only"
    },
    "@dzupagent/connectors-documents#build": {
      "dependsOn": ["^build:verify", "@dzupagent/core#build:verify"],
      "outputs": ["dist/**"],
      "outputLogs": "new-only"
    },
    "@dzupagent/test-utils#build": {
      "dependsOn": ["^build:verify", "@dzupagent/testing#build:verify"],
      "outputs": ["dist/**"],
      "outputLogs": "new-only"
    },
    "@dzupagent/memory#build": {
      "dependsOn": ["^build:verify", "@dzupagent/memory-ipc#build:verify"],
      "outputs": ["dist/**"],
      "outputLogs": "new-only"
    },
    "@dzupagent/app-tools#build": {
      "dependsOn": [
        "^build:verify",
        "@dzupagent/code-edit-kit#build:verify",
        "@dzupagent/hitl-kit#build:verify"
      ],
      "outputs": ["dist/**"],
      "outputLogs": "new-only"
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build:verify", "^typecheck"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "@dzupagent/memory#typecheck": {
      "dependsOn": ["@dzupagent/memory-ipc#build:verify"]
    },
    "@dzupagent/connectors#typecheck": {
      "dependsOn": ["^build:verify", "^typecheck", "@dzupagent/flow-ast#build:verify"],
      "outputs": []
    },
    "@dzupagent/agent-adapters#typecheck": {
      "dependsOn": [
        "^build:verify",
        "@dzupagent/adapter-rules#build:verify",
        "@dzupagent/adapter-types#build:verify",
        "@dzupagent/agent#build:verify",
        "@dzupagent/agent-types#build:verify",
        "@dzupagent/core#build:verify",
        "@dzupagent/runtime-contracts#build:verify",
        "@dzupagent/security#build:verify",
        "@dzupagent/subagents#build:verify"
      ],
      "outputs": []
    },
    "lint": {
      "inputs": ["src/**", "package.json", ".eslintrc*", "eslint.config.*"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "test": {
      "dependsOn": ["^build:verify"],
      "inputs": [
        "src/**",
        "test/**",
        "package.json",
        "tsconfig.json",
        "vitest.config.*"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "@dzupagent/agent#test": {
      "dependsOn": ["^build:verify", "@dzupagent/agent#build:verify"],
      "inputs": ["src/**", "package.json", "tsconfig.json", "vitest.config.*"],
      "outputs": []
    },
    "@dzupagent/agent-adapters#test": {
      "dependsOn": ["^build:verify", "@dzupagent/agent-adapters#build:verify"],
      "inputs": ["src/**", "package.json", "tsconfig.json", "vitest.config.*"],
      "outputs": []
    },
    "@dzupagent/evals#test": {
      "dependsOn": ["^build:verify"],
      "inputs": ["src/**", "package.json", "tsconfig.json", "vitest.config.*"],
      "outputs": []
    },
    "@dzupagent/rag#test": {
      "dependsOn": ["^build:verify"],
      "inputs": ["src/**", "package.json", "tsconfig.json", "vitest.config.*"],
      "outputs": []
    },
    "@dzupagent/test-utils#test": {
      "dependsOn": ["^build:verify"],
      "inputs": ["src/**", "package.json", "tsconfig.json", "vitest.config.*"],
      "outputs": []
    },
    "@dzupagent/testing#test": {
      "dependsOn": ["^build:verify"],
      "inputs": ["src/**", "package.json", "tsconfig.json", "vitest.config.*"],
      "outputs": []
    },
    "@dzupagent/server#test": {
      "dependsOn": ["^build:verify"],
      "inputs": ["src/**", "package.json", "tsconfig.json", "vitest.config.*"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build:verify"],
      "inputs": [
        "src/**",
        "package.json",
        "tsconfig.json",
        "vitest.integration.config.*"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "@dzupagent/server#test:integration": {
      "dependsOn": ["^build:verify"],
      "inputs": [
        "src/**",
        "package.json",
        "tsconfig.json",
        "vitest.integration.config.*"
      ],
      "outputs": []
    },
    "@dzupagent/dialogue-core-replay#test": {
      "dependsOn": ["^build:verify", "@dzupagent/dialogue-core-replay#build:verify"],
      "inputs": ["src/**", "test/**", "package.json", "tsconfig.json"],
      "outputs": []
    }
  }
}
