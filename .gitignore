# Dependency directories
node_modules/
jspm_packages/

# Build artifacts
dist/
build/
*.tsbuildinfo
.turbo/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
.DS_Store
.claude/worktrees/
.codex
.codex/

# Testing
coverage/
.nyc_output/
vitest.config.ts.timestamp-*.mjs

# Documentation
docs/api/
.serena/
.docs/

# Package manager lockfiles not used in this repo
package-lock.json
pnpm-lock.yaml
bun.lockb

# Generic local logs
*.log

# Local agent worktrees
.worktrees/

# Local-only concurrency-guard opt-out. Must never be committed: a committed
# marker disables the guard for every future session in every clone.
.claude-concurrency-ok

# transient type-resolution probe scratch dirs
**/.*-types-*/
**/.types-resolution-*/

# Yarn local resolution cache (regenerated; must not be tracked)
.yarn/install-state.gz
