      "surfaceId": "agent-types-root",
      "symbol": "MemoryScope",
      "disposition": "extend",
      "target": "MEM-P001 compatibility adapter",
      "rationale": "Keep the Layer-0 transport scope stable while MemoryScopeV1 adds namespace and finer optional dimensions."
    },
    {
      "surfaceId": "agent-types-root",
      "symbol": "MemoryQuery",
      "disposition": "extend",
      "target": "MEM-P004 compatibility adapter",
      "rationale": "Preserve the advisory transport query while the strict lifecycle-aware query uses a versioned memory subpath."
    },
    {
      "surfaceId": "agent-types-root",
      "symbol": "MemoryRecord",
      "disposition": "extend",
      "target": "MEM-P001 compatibility adapter",
      "rationale": "Preserve CRUD transport compatibility; do not mutate the Layer-0 shape into the semantic lifecycle record."
    },
    {
      "surfaceId": "memory-root",
      "symbol": "MemoryService",
      "disposition": "extend",
      "target": "MEM-P003 opt-in service facade",
      "rationale": "Reuse namespace storage and add lifecycle operations behind an opt-in narrow facade."
    },
    {
      "surfaceId": "memory-root",
      "symbol": "StagedWriter",
      "disposition": "deprecate",
      "target": "MEM-P002 lifecycle reducer",
      "rationale": "Keep compatibility during 0.x, but numeric confidence thresholds must not become the canonical promotion contract."
    },
    {
      "surfaceId": "memory-root",
      "symbol": "PolicyAwareStagedWriter",
      "disposition": "extend",
      "target": "MEM-P002 policy decision adapter",
      "rationale": "Reuse its sensitive-write guard and adapt admitted decisions to canonical commands and receipts."
    },
    {
      "surfaceId": "memory-root",
      "symbol": "StagedRecord",
      "disposition": "extend",
      "target": "MEM-P001 staged-record adapter",
      "rationale": "Translate staged records into MemoryRecordV1 without rewriting stored legacy values."
    },
    {
      "surfaceId": "memory-root",
      "symbol": "ObservationConfirmationReceipt",
      "disposition": "extend",
      "target": "MEM-P002 transition receipt adapter",
      "rationale": "Preserve digest-bound idempotency while adopting the canonical transition receipt envelope."
    },
    {
      "surfaceId": "memory-root",
      "symbol": "MemoryServiceObservationCandidateStore",
      "disposition": "extend",
      "target": "MEM-P003 canonical candidate-store adapter",
      "rationale": "Reuse restart-safe candidate custody and map values and receipts through the canonical contract."
    },
    {
      "surfaceId": "memory-root",
      "symbol": "MemoryProvenance",
      "disposition": "extend",
      "target": "MEM-P001 provenance adapter",
      "rationale": "Retain current source lineage and add bounded evidence, review, and extraction-profile references."
    },
    {
      "surfaceId": "memory-root",
      "symbol": "TemporalMetadata",
      "disposition": "extend",
      "target": "MEM-P001 temporal adapter",
      "rationale": "Separate observation, domain validity, verification, and expiry time in the canonical record."
    },
    {
      "surfaceId": "memory-root",
      "symbol": "TemporalQuery",
      "disposition": "extend",
      "target": "MEM-P004 query adapter",
      "rationale": "Reuse temporal filtering semantics inside the strict versioned query."
    },
    {
      "surfaceId": "memory-root",
      "symbol": "RetentionPolicy",
      "disposition": "extend",
      "target": "MEM-P001 retention profile reference",
      "rationale": "Keep existing shared-space retention behavior and move product durations behind policy references."
    },
    {
      "surfaceId": "memory-root",
      "symbol": "FrozenMemorySnapshot",
      "disposition": "extend",
      "target": "MEM-P004 lifecycle-aware snapshot selection",
      "rationale": "Reuse snapshot stability while binding selected active versions and invalidation inputs."
    },
    {
      "surfaceId": "context-root",
      "symbol": "autoCompress",
      "disposition": "extend",
      "target": "MEM-P004 completed-tool compaction",
      "rationale": "Retain current context compression and add pairing-aware completed-tool compaction."
    },
    {
      "surfaceId": "context-root",
      "symbol": "FrozenSnapshot",
      "disposition": "extend",
      "target": "MEM-P004 prompt-cache-stable compaction",
      "rationale": "Reuse immutable snapshot semantics and record actual token reclamation."
    },
    {
      "surfaceId": "memory-ipc-root",
